{
  "version": 2,
  "routes": [
    { "src": "/research", "status": 301, "headers": { "Location": "/dashboard" } },
    { "src": "/research/(.*)", "status": 301, "headers": { "Location": "/dashboard" } },
    { "src": "/quantvue", "status": 301, "headers": { "Location": "/dashboard" } },
    { "src": "/quantvue/(.*)", "status": 301, "headers": { "Location": "/dashboard" } },
    { "src": "/medtech/(.*)", "dest": "/medtech/$1" }
  ],
  "headers": [
    {
      "source": "/medtech/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/cyclevue/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/blackwatch/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/blackwatch/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
